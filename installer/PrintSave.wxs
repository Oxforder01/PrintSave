<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="PrintSave"
           Manufacturer="PrintSave"
           Version="$(var.ProductVersion)"
           UpgradeCode="7F3A2C14-9B6E-4D2A-A1C7-8E5B0F3D6A21"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="PrintSave — saves every printed document as a dated PDF" />

    <!-- Replace any older build in place; block downgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of PrintSave is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Close a running tray before an uninstall/upgrade touches its files. The tray is a
         windowless NotifyIcon app, so a WM_CLOSE message has nothing to land on; force-kill
         it (exit code 0) so uninstall/upgrade never leaves a zombie running from deleted files. -->
    <util:CloseApplication Id="CloseTray"
                           Target="PrintSave.Tray.exe"
                           CloseMessage="yes"
                           TerminateProcess="0"
                           RebootPrompt="no"
                           EndSessionMessage="yes" />

    <!-- Remembered install path, so RemoveFolderEx can wipe the folder on uninstall.
         RemoveFolder alone only deletes an empty dir, and the force-killed tray can
         briefly hold its exe, leaving the folder behind. -->
    <Property Id="INSTALLFOLDERSAVED">
      <RegistrySearch Id="FindInstallFolder" Root="HKLM" Key="Software\PrintSave"
                      Name="InstallFolder" Type="raw" />
    </Property>

    <!-- Install locations. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PrintSave" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="PrintSave" />
    </StandardDirectory>
    <!-- All-Users Startup folder (perMachine resolves this to the common startup). -->
    <StandardDirectory Id="StartupFolder" />

    <!-- The Windows service: its own component so the exe is the service's key file. -->
    <ComponentGroup Id="ServiceGroup" Directory="INSTALLFOLDER">
      <Component Id="ServiceExe" Guid="*">
        <File Id="PrintSaveServiceExe"
              Source="$(var.PublishDir)\PrintSave.Service.exe"
              KeyPath="yes" />
        <ServiceInstall Id="PrintSaveSvcInstall"
                        Name="PrintSave"
                        DisplayName="PrintSave"
                        Description="Saves every printed document as a PDF, organized by date."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="PrintSaveSvcControl"
                        Name="PrintSave"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- Everything else the publish produced: the tray, the console host and all shared DLLs. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\PrintSave.Service.exe" />
      </Files>
    </ComponentGroup>

    <!-- Start-menu shortcut to the tray. -->
    <ComponentGroup Id="Shortcuts" Directory="AppShortcutFolder">
      <Component Id="TrayShortcut" Guid="*">
        <Shortcut Id="TrayStartMenu"
                  Name="PrintSave"
                  Description="Open the PrintSave tray"
                  Target="[INSTALLFOLDER]PrintSave.Tray.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKMU" Key="Software\PrintSave" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- On uninstall, recursively remove the install folder (program files only). -->
    <ComponentGroup Id="Cleanup" Directory="INSTALLFOLDER">
      <Component Id="CleanupInstallFolder" Guid="*">
        <RegistryValue Root="HKLM" Key="Software\PrintSave" Name="InstallFolder"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDERSAVED" />
      </Component>
    </ComponentGroup>

    <!-- Start the tray at sign-in via an All-Users Startup shortcut. This is per-machine,
         MSI-managed (installed and removed cleanly), and reliable for every user — unlike a
         per-user HKCU Run value, which a per-machine install writes to the wrong hive. The
         Settings "start at sign-in" checkbox remains a per-user override. -->
    <ComponentGroup Id="Autostart" Directory="StartupFolder">
      <Component Id="TrayStartupShortcut" Guid="*">
        <Shortcut Id="TrayStartup"
                  Name="PrintSave"
                  Description="PrintSave tray"
                  Target="[INSTALLFOLDER]PrintSave.Tray.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\PrintSave" Name="autostart"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="PrintSave" Level="1">
      <ComponentGroupRef Id="ServiceGroup" />
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="Autostart" />
      <ComponentGroupRef Id="Cleanup" />
    </Feature>

    <!-- Launch the tray once so the user sees it right away. Start-at-sign-in is set by the
         AutoStartRunKey component above, not here. -->
    <CustomAction Id="LaunchTray"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]PrintSave.Tray.exe&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />
    <!-- Final sweep on full uninstall: the self-terminating tray can leave its (now-empty)
         folder with a delete-pending handle, so RemoveFolder/RemoveFolderEx can't clear the
         directory itself. After everything else is done, force-remove it. Guarded off major
         upgrades so it never deletes a freshly-installed newer version. -->
    <CustomAction Id="RemoveInstallDir"
                  Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c rd /s /q &quot;[INSTALLFOLDER]&quot;"
                  Execute="immediate"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="LaunchTray" After="InstallFinalize" Condition="NOT Installed" />
      <Custom Action="RemoveInstallDir" After="InstallFinalize"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Minimal wizard: welcome + license + progress + finish. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
